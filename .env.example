# ==============================================================================
# Dalkia LiveAssist - Configuration Template
# ==============================================================================

# Google Cloud & Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Live API & Agent Models
DALKIA_LIVE_MODEL=gemini-3.8-live
DALKIA_AGENT_MODEL=gemini-2.5-flash

# RAG Corpus configuration (optional for Vertex AI RAG Engine)
DALKIA_RAG_CORPUS_ID=dalkia-manuals-corpus
ENABLE_VERTEX_RAG_TOOL=false

# Web Interface Port
PORT=8085
