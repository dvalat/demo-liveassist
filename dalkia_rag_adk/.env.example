# Configuration Google Cloud & Vertex AI RAG pour Dalkia
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
DALKIA_RAG_CORPUS_ID=dalkia-manuals-corpus

# Modèle principal configuré pour l'application Dalkia
DALKIA_AGENT_MODEL=gemini-2.5-flash
DALKIA_LIVE_MODEL=gemini-3.8-live

# Activation du composant natif VertexAiRagRetrieval si corpus déployé sur Vertex AI
ENABLE_VERTEX_RAG_TOOL=false
